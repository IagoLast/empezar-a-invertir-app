SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET
REVENUECAT_WEBHOOK_AUTH=Bearer_REPLACE_WITH_RANDOM_SECRET
REVENUECAT_APP_ID=app_REPLACE
REVENUECAT_ENVIRONMENT=SANDBOX
# Finnhub key stays on the server. Quotes cache: 15 min; fundamentals: 24 h.
FINNHUB_API_KEY=
ENABLE_FUNDAMENTALS=true

# Optional secondary source; shared daily budget and cache require the Alpha migration.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_DAILY_LIMIT=25

# EODHD market data (backend only)
EODHD_API_KEY=
