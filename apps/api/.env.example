SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET
REVENUECAT_WEBHOOK_AUTH=Bearer_REPLACE_WITH_RANDOM_SECRET
REVENUECAT_APP_ID=app_REPLACE
REVENUECAT_ENVIRONMENT=SANDBOX
# Yahoo Finance does not require an API key. Quotes cache: 15 min; fundamentals: 24 h.
ENABLE_FUNDAMENTALS=true
